   <property name="styleSheet">
    <string notr="true">QWidget#centralwidget {
	background-color: #1e1e1e;
	color: #d4d4d4;
}
QWidget {
	font-family: Consolas;
	font-size: 18px;
}
QLabel {
	color: #d4d4d4;
}
QGroupBox {
	background-color: #252526;
	border: 1px solid #454545;
	border-radius: 6px;
	margin-top: 14px;
	padding: 3px;
}
QGroupBox::title {
	subcontrol-origin: margin;
	subcontrol-position: top left;
	left: 12px;
	padding: 0 4px;
	color: #4fc1ff;
}
QGroupBox#controlGroup {
	margin-top: 0px;
}
QPushButton {
	background-color: #333333;
	color: #ffffff;
	border: 1px solid #555555;
	border-radius: 6px;
	padding: 3px 12px;
}
QPushButton:pressed {
	background-color: #094771;
	border-color: #4fc1ff;
}
QPushButton:disabled {
	background-color: #292929;
	color: #777777;
	border-color: #383838;
}
QPushButton#exitButton {
	background-color: #683333;
}
QPushButton#exitButton:pressed {
	background-color: #8c4242;
}
QPushButton#applySettingsButton, QPushButton#recordButton {
	background-color: #094771;
}
QLabel#apStatusLabel, QLabel#icmStatusLabel, QLabel#settingsHintLabel {
	color: #dcdcaa;
}
QLabel#settingsHintLabel, QLabel#configPathLabel, QLabel#recordInfoLabel, QLabel#recordPathLabel {
	font-size: 16px;
	color: #999999;
}
QWidget#monitorPage, QWidget#settingsPage, QWidget#recordPage {
	background-color: #1e1e1e;
}
QTabWidget::pane {
	border: 1px solid #454545;
	border-radius: 6px;
	top: -1px;
}
QTabBar::tab {
	background-color: #2d2d30;
	color: #d4d4d4;
	min-width: 108px;
	min-height: 36px;
	padding: 0 15px;
}
QTabBar::tab:selected {
	background-color: #094771;
	color: #ffffff;
}
QCheckBox {
	color: #d4d4d4;
	spacing: 9px;
}
QCheckBox::indicator {
	width: 27px;
	height: 27px;
}
QCheckBox:disabled {
	color: #777777;
}
QSpinBox {
	background-color: #333333;
	color: #ffffff;
	border: 1px solid #555555;
	border-radius: 6px;
	padding: 2px 39px 2px 9px;
}
QSpinBox::up-button, QSpinBox::down-button {
	width: 36px;
}
QStatusBar {
	font-size: 16px;
	color: #999999;
}
</string>
