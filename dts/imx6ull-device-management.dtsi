#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>

/ {
    led_dev {
        compatible = "smartmonitor,led0";
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_led>;
        led-gpios = <&gpio1 3 GPIO_ACTIVE_LOW>;
        status = "okay";
    };

    key_input_dev {
        compatible = "smartmonitor,key0";
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_key>;
        key-gpios = <&gpio1 18 GPIO_ACTIVE_LOW>;
        linux,code = <KEY_ENTER>;
        debounce-interval = <20>;
        status = "okay";
    };
};

/* GT911 CT_RST：SNVS_TAMPER9，GPIO5_IO09 */
&iomuxc_snvs {
    imx6ul-evk {
        pinctrl_gt911_reset: gt911resetgrp {
            fsl,pins = <
                MX6ULL_PAD_SNVS_TAMPER9__GPIO5_IO09    0X10B0
            >;
        };
    };
};

&iomuxc {
    imx6u-evk {
        pinctrl_led: ledgrp {
            fsl,pins = <
                MX6UL_PAD_GPIO1_IO03__GPIO1_IO03    0X10B0
            >;
        };

        pinctrl_key: keygrp {
            fsl,pins = <
                MX6UL_PAD_UART1_CTS_B__GPIO1_IO18    0XF080
            >;
        };

        /* AP3216C INT（原理图 AP_INT）：低电平有效，打开内部上拉。BSP 中该脚只被已关闭的 tsc 使用 */
        pinctrl_ap3216c_int: ap3216cintgrp {
            fsl,pins = <
                MX6UL_PAD_GPIO1_IO01__GPIO1_IO01    0XF080
            >;
        };

        /*
         * ALPHA V2.4 本地 BSP 适配：BSP 已定义 pinctrl_ecspi3（相同四个引脚）和
         * pinctrl_icm20608（6D_INT 中断脚），这里不再重复定义，避免 dtc 报 Duplicate label。
         */

        pinctrl_uart3: uart3grp {
            fsl,pins = <
                MX6UL_PAD_UART3_TX_DATA__UART3_DCE_TX    0X1B0B1
                MX6UL_PAD_UART3_RX_DATA__UART3_DCE_RX    0X1B0B1
            >;
        };

        pinctrl_gt911_int: gt911intgrp {
            fsl,pins = <
                MX6UL_PAD_GPIO1_IO09__GPIO1_IO09    0X00B0
            >;
        };
    };
};

&i2c1 {
    status = "okay";

    /* BSP 遗留的 EVK 传感器节点：fxls8471 占用 0x1e，与 AP3216C 冲突；板上也没有 mag3110 */
    /delete-node/ fxls8471@1e;
    /delete-node/ mag3110@0e;

    ap3216c@1e {
        compatible = "liteon,ap3216c";
        reg = <0x1e>;
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_ap3216c_int>;
        /* 接近事件：PS 越过阈值时 INT 拉低，驱动读状态后写 1 清除 */
        interrupt-parent = <&gpio1>;
        interrupts = <1 IRQ_TYPE_LEVEL_LOW>;
        status = "okay";
    };
};

&uart2 {
    status = "disabled";
};

&ecspi3 {
    fsl,spi-num-chipselects = <1>; /* 一个片选 */
    cs-gpios = <&gpio1 20 GPIO_ACTIVE_LOW>;
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_ecspi3>;
    status = "okay";

    /*
     * ICM-20608-D 由自研 IIO 驱动（icm20608-driver/）管理：
     * regmap-spi + IIO，数据就绪中断（6D_INT = GPIO1_IO10 上升沿）驱动 triggered buffer。
     * 与 BSP 中同名的 imu@0 节点合并，这里把属性写全，不依赖 BSP 是否已有该节点
     */
    imu@0 {
        compatible = "invensense,icm20608d";
        reg = <0>;
        spi-max-frequency = <1000000>;
        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_icm20608>; /* BSP：JTAG_MOD 复用为 GPIO1_IO10 */
        interrupt-parent = <&gpio1>;
        interrupts = <10 IRQ_TYPE_EDGE_RISING>;
        status = "okay";
    };
};

&uart3 {
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_uart3>;
    status = "okay";
};

/* 保留 SD 卡检测和 VSELECT，释放 GPIO1_IO09 */
&pinctrl_hog_1 {
    fsl,pins = <
        MX6UL_PAD_UART1_RTS_B__GPIO1_IO19       0X17059
        MX6UL_PAD_GPIO1_IO05__USDHC1_VSELECT    0X17059
    >;
};

/* SD 卡固定 3.3V 供电，解除对 CT_INT 引脚的错误占用 */
&reg_sd1_vmmc {
    /delete-property/ gpio;
    /delete-property/ enable-active-high;

    regulator-always-on;
};

&i2c2 {
    clock-frequency = <100000>;
    status = "okay";
    gt911: touchscreen@14 {
        compatible = "goodix,gt911";
        reg = <0x14>;

        pinctrl-names = "default";
        pinctrl-0 = <&pinctrl_gt911_int
                     &pinctrl_gt911_reset>;

        /* 中断来自 GPIO1 控制器 */
        interrupt-parent = <&gpio1>;

        /* 由驱动读取 0x804D 后设置实际触发方式 */
        interrupts = <9 IRQ_TYPE_NONE>;

        irq-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio5 9 GPIO_ACTIVE_LOW>;

        /* ATK-4384 4.3 寸 800x480，触摸 IC 实测为 GT1158（产品 ID "1158"） */
        touchscreen-size-x = <800>;
        touchscreen-size-y = <480>;

        status = "okay";
    };
};

/*
 * BSP 沿用 NXP EVK 配置，把 SNVS_TAMPER9 当作 LCD 复位放进 lcdif 的 pinctrl；
 * ALPHA 板上该脚实际接触摸芯片复位（TSC_RST），这里把它从 lcdif 中去掉
 */
&lcdif {
    pinctrl-0 = <&pinctrl_lcdif_dat
                 &pinctrl_lcdif_ctrl>;
};

/*
 * 屏幕为正点原子 ATK-4384（4.3 寸 800x480，LCD ID 引脚读出），BSP 默认是 480x272 时序。
 * 参数取自出厂内核 imx6ull-14x14-emmc-4.3-800x480-c.dts（出厂 U-Boot 按 LCD ID 自动选用），
 * 像素时钟 33 MHz（驱动开发指南 64.7 节写 31 MHz，以出厂实测可用的为准）
 */
&timing0 {
    clock-frequency = <33000000>;
    hactive = <800>;
    vactive = <480>;
    hfront-porch = <40>;
    hback-porch = <88>;
    hsync-len = <48>;
    vback-porch = <32>;
    vfront-porch = <13>;
    vsync-len = <3>;
};

/* 关闭不用的片内电阻触摸控制器 */
&tsc {
    status = "disabled";
};

